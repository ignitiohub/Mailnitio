# Copy to .env for local development. Never commit .env.
# Local Postgres runs in Docker on port 54329: `docker compose up -d`.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Owner role: migrations only.
DATABASE_URL_OWNER=postgres://mailnitio_owner:mailnitio_owner_dev@127.0.0.1:54329/mailnitio
# Runtime roles. `pnpm db:migrate` sets their passwords from APP_DB_PASSWORD / AUTH_DB_PASSWORD.
APP_DB_PASSWORD=mailnitio_app_dev
AUTH_DB_PASSWORD=mailnitio_auth_dev
DATABASE_URL=postgres://mailnitio_app:mailnitio_app_dev@127.0.0.1:54329/mailnitio
DATABASE_URL_AUTH=postgres://mailnitio_auth:mailnitio_auth_dev@127.0.0.1:54329/mailnitio

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILNITIO_KEK=
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# The browser only talks to the web app, which proxies /api/auth and /v1 to the API.
API_PUBLIC_URL=http://localhost:3400
WEB_ORIGIN=http://localhost:3400
API_ORIGIN=http://localhost:3401
PORT=3401
NEXT_PUBLIC_SITE_URL=http://localhost:3400
NEXT_PUBLIC_APP_ENV=local

# Optional locally. Without RESEND_API_KEY, system emails (verification links) are printed to the API log.
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=Mailnitio <no-reply@mailnitio.com>
LEADS_NOTIFY_EMAIL=sales@mailnitio.com
SLACK_WEBHOOK_URL=

# Optional locally. Without Turnstile keys the captcha check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional locally.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
